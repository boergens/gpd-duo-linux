[Unit]
Description=Fix GPD Duo webcam disconnect issue
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo disabled > /proc/sys/kernel/rfkill_input 2>/dev/null; echo 0 > /sys/bus/usb/devices/usb3/authorized; sleep 1; echo 1 > /sys/bus/usb/devices/usb3/authorized'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
